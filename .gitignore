# ==================== Python ====================
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ==================== 环境变量 ====================
.env
.env.local
.env.*.local
!.env.example

# ==================== 你的实际内容（不上传） ====================
# 数据库、简历（保留目录 + .gitkeep）
backend/data/*
!backend/data/.gitkeep
# 上传的媒体素材（保留目录 + .gitkeep）
backend/static/*
!backend/static/.gitkeep
# 真实事实库（提供 .example 模板）
backend/facts/facts.yaml
# 前端 public 里的媒体
frontend/public/

# ==================== 根目录冗余 static ====================
/static/

# ==================== 前端依赖/构建 ====================
node_modules/
frontend/dist/
frontend/.vite/

# ==================== 系统 ====================
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# ==================== 日志 ====================
*.log
logs/

# ==================== 临时脚本 ====================
backend/_*.py
frontend/_*.js
frontend/_diag.js

# ==================== 本地启动脚本 ====================
启动.bat
启动.sh