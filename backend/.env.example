# ===== DeepSeek =====
DEEPSEEK_API_KEY=sk-你的key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ===== 预算与限流 =====
DAILY_BUDGET_CNY=10
RATE_LIMIT_PER_IP_PER_MIN=20
SESSION_TOKEN_DAILY_CAP=50000
LLM_CONCURRENCY=3
LLM_TIMEOUT_SEC=60

# ===== 路径 =====
DB_PATH=./data/cvbot.db
FACTS_PATH=./facts/facts.yaml

# ===== 飞书 =====
FEISHU_WEBHOOK_URL=

# ===== 管理后台 =====
ADMIN_TOKEN=换成你自己的强密码

# ===== 前端 =====
FRONTEND_ORIGIN=http://localhost:5173