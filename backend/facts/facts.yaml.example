# CV_Bot 事实库模板
# 使用方式：
#   1. 复制此文件为 facts.yaml:  Copy-Item facts.yaml.example facts.yaml
#   2. 把下面的示例内容改成你自己的真实信息
#   3. 保存后重启后端
#
# 规则：
#   - id 稳定不变，格式 F-001 ~ F-999
#   - public: true  = 可以对外回答
#   - public: false = 不对外，仅用于内部

- id: F-001
  topic: basic
  key: name
  value: "你的名字"
  public: true

- id: F-002
  topic: basic
  key: title
  value: "后端 / AI 应用开发"
  public: true

- id: F-003
  topic: basic
  key: github
  value: "https://github.com/你的用户名"
  public: true

- id: F-010
  topic: skill
  key: backend
  value: "Python / FastAPI / SQLite / Docker"
  public: true

- id: F-011
  topic: skill
  key: frontend
  value: "React / TypeScript / Vite"
  public: true

- id: F-012
  topic: skill
  key: ai
  value: "LLM 应用、SSE 流式、事实库约束、防幻觉验证"
  public: true

- id: F-020
  topic: project
  key: cv-bot
  value: "CV_Bot：FastAPI + React + DeepSeek，不做 RAG，全量注入事实库，配确定性验证器"
  public: true

